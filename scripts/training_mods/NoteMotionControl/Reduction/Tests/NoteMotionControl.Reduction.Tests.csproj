    <Reference Include="DataModels" HintPath="$(GameRoot)\Beat Saber_Data\Managed\DataModels.dll" />
    <Reference Include="AdditionalContentModel.Interfaces" HintPath="$(GameRoot)\Beat Saber_Data\Managed\AdditionalContentModel.Interfaces.dll" />
