<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>12</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <EnableFrameworkPathOverride>true</EnableFrameworkPathOverride>
    <FrameworkPathOverride>$(GameRoot)/Beat Saber_Data/Managed</FrameworkPathOverride>
    <AssemblyName>ActivityEnergyCounter</AssemblyName>
    <RootNamespace>ActivityEnergyCounter</RootNamespace>
    <Version>0.2.1</Version>
    <InformationalVersion>0.2.1+bs1.45.2</InformationalVersion>
    <OutputPath>$(RepoRoot)/.tmp/training-mods/energy/build/bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0649;CS0414;CS0618</NoWarn>
    <LocalModUIPath Condition="'$(LocalModUIPath)' == ''">$(RepoRoot)/.tmp/local-mod-ui/build/LocalModUI.dll</LocalModUIPath>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ActivityEnergyCounter.Tests" />
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/HMLib.dll" Private="false" />
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.SubsystemsModule.dll" Private="false" />
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.XRModule.dll" Private="false" />
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.VRModule.dll" Private="false" />
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/BeatSaber.Settings.dll" Private="false" />
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/BeatSaber.GameSettings.dll" Private="false" />
    <Compile Include="../Shared/ProfileStore.cs" Link="Shared/ProfileStore.cs" />
    <Reference Include="LocalModUI" HintPath="$(LocalModUIPath)" Private="false" />
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/BGLib.Polyglot.dll" Private="false" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/Main.dll">
      <Private>false</Private>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/DataModels.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/GameplayCore.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/BeatSaber.ViewSystem.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/BGLib.AppFlow.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/BGLib.UnityExtension.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/IPA.Loader.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.CoreModule.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.UI.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/Unity.TextMeshPro.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/HMUI.dll">
      <Private>false</Private>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/Zenject.dll">
      <Private>false</Private>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/Zenject-usage.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameRoot)/Libs/0Harmony.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameRoot)/Libs/Newtonsoft.Json.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameRoot)/Plugins/BSML.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameRoot)/Plugins/SiraUtil.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameRoot)/Plugins/Counters+.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/netstandard.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.TextRenderingModule.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameRoot)/Beat Saber_Data/Managed/UnityEngine.TextCoreFontEngineModule.dll">
      <Private>false</Private>
    </Reference>
    <EmbeddedResource Include="UI/Settings.bsml">
      <LogicalName>ActivityEnergyCounter.UI.Settings.bsml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="manifest.json">
      <LogicalName>ActivityEnergyCounter.manifest.json</LogicalName>
    </EmbeddedResource>
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>
</Project>
