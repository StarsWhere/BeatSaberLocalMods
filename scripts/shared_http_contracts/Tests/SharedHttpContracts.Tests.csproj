  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
    <Compile Include="../JsonContractRegistry.cs" Link="JsonContractRegistry.cs" />
  </ItemGroup>
</Project>
